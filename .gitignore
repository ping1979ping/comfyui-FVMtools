__pycache__/
*.pyc
*.pyo
.claude/
*.egg-info/
dist/
build/
.eggs/
troubleshooting/

# Test-run leftovers when MagicMock objects accidentally end up as paths
MagicMock/

# User-authored JB Builder wildcards. The directory itself is tracked
# via .gitkeep so a fresh clone has a target for the INI default, but
# every user file inside is ignored — `git pull` never overwrites local
# wildcard text. To share wildcards with the repo, commit them under a
# different tracked path and point wildcards.ini at it.
/wildcards/*
!/wildcards/.gitkeep

# Optional local override for the wildcards path. Drop a personal
# wildcards.ini.local next to wildcards.ini and the user can keep
# their own path setting without conflicting with future pulls.
/wildcards.ini.local
.mcp.json

# Demo images written by tests/artifacts/*.py. The scripts are tracked so the
# rendering can be re-verified on any machine; the PNGs they produce are not.
/tests/artifacts/*.png

# Live-run artefacts: scenes, probe previews, masks and captured run logs. The
# scripts under tests/live are tracked so the runs can be repeated; what they
# produce is not.
/tests/live/*.png
/tests/live/*_run.txt
/tests/live/*_serverlog.txt
/tests/live/*_meta.txt
/tests/live/*.json
/tests/live/baseline_unit.txt
/tests/live/*_census.txt
